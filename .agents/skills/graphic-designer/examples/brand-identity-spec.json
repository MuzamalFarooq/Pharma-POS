{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brandName": "PharmaPulse",
  "archetype": "Modern Clinical & High-Tech Precision",
  "description": "Enterprise pharmacy management & point-of-sale visual identity specification.",
  "colorPalette": {
    "distribution": {
      "base60": "#F8FAFC",
      "structure30": "#FFFFFF",
      "accent10": "#0D9488"
    },
    "tokens": {
      "canvas": {
        "light": "#F8FAFC",
        "dark": "#0B1120"
      },
      "surface": {
        "light": "#FFFFFF",
        "dark": "#1E293B"
      },
      "brandPrimary": {
        "base": "#0D9488",
        "hover": "#0F766E",
        "glow": "rgba(13, 148, 136, 0.25)"
      },
      "brandSecondary": {
        "base": "#0284C7",
        "hover": "#0369A1"
      },
      "text": {
        "heading": "#0F172A",
        "body": "#334155",
        "muted": "#64748B",
        "inverse": "#F8FAFC"
      },
      "feedback": {
        "success": "#16A34A",
        "warning": "#F59E0B",
        "danger": "#E11D48",
        "info": "#0284C7"
      }
    }
  },
  "typography": {
    "headingFont": "Plus Jakarta Sans, sans-serif",
    "bodyFont": "Inter, sans-serif",
    "monoFont": "Geist Mono, monospace",
    "scale": {
      "display": { "size": "40px", "lineHeight": "1.15", "letterSpacing": "-0.03em", "weight": 700 },
      "h1": { "size": "32px", "lineHeight": "1.2", "letterSpacing": "-0.025em", "weight": 700 },
      "h2": { "size": "24px", "lineHeight": "1.25", "letterSpacing": "-0.02em", "weight": 600 },
      "h3": { "size": "20px", "lineHeight": "1.3", "letterSpacing": "-0.015em", "weight": 600 },
      "body": { "size": "16px", "lineHeight": "1.6", "letterSpacing": "0", "weight": 400 },
      "caption": { "size": "13px", "lineHeight": "1.4", "letterSpacing": "0.01em", "weight": 500 },
      "badge": { "size": "11px", "lineHeight": "1", "letterSpacing": "0.06em", "weight": 700, "textTransform": "uppercase" }
    }
  },
  "gridAndSpacing": {
    "unit": 8,
    "spacers": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px",
      "3xl": "64px"
    },
    "borderRadius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "full": "9999px"
    }
  }
}
